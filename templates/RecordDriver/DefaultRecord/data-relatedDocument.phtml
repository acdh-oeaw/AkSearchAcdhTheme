<?php if (count($data) > 0) : ?>
    <div class="wrapper">
        <div>
            <?php foreach ($data as $current): ?>
                <?php
                $relatedAC = preg_replace('/^\(AT-OBV\)/', '', $current->w ?? '');
                $title = $current->t ?? $relatedAC;
                ?>
                <?php if ($relatedAC !== ''): ?>
                    <a href="<?= $this->escapeHtmlAttr($this->recordLinker()->getUrl($relatedAC)) ?>"
                       target="_blank" rel="noopener noreferrer"><?= $this->escapeHtml($title) ?></a><br>
                <?php endif; ?>
            <?php endforeach; ?>
        </div>
    </div>
<?php endif; ?>
