<?php
  $openUrl = $this->openUrl($this->driver, 'record');
  $openUrlActive = $openUrl->isActive();
  $doi = $this->doi($this->driver, 'record');
  $doiActive = $doi->isActive();
  // Account for replace_other_urls setting
  $urls = $this->record($this->driver)->getLinkDetails($openUrlActive);
  // Keep the MARC 856 $z note alongside its URL only while rendering. The
  // driver supplies the existing $3/$x description in $current['desc'].
  $urlNotes = [];
  foreach ($this->driver->getMarcRecord()->getFields('856') as $urlField) {
    $urlSubfield = $urlField->getSubfield('u');
    if (!is_object($urlSubfield)) {
      continue;
    }
    $noteSubfield = $urlField->getSubfield('z');
    $urlNotes[] = is_object($noteSubfield) ? $noteSubfield->getData() : '';
  }
?>

<?php  if(count($urls) > 0) : ?>

<div class="online-access-urls-list closed">
    <div class="wrapper">
        <div>
            <?php if(count($urls) > 3) : ?>
                <a class="entity-fact-info-link display-all-online-access" href="#"><i class="fa fa-caret-down"></i></a>
            <?php endif; ?>
        </div>
        <div>
            <?php foreach ($urls as $index => $current): ?>
            <?php // AK: Translate the description ?>
                <a href="<?=$this->escapeHtmlAttr($this->proxyUrl($current['url']))?>" target="_blank"><?=$this->transEsc($current['desc'])?><?php if (!empty($urlNotes[$index])): ?> (<?=$this->escapeHtml($urlNotes[$index])?>)<?php endif; ?></a><br/>
            <?php endforeach; ?>
        </div>
    </div>
</div>
<?php endif; ?>

<?php if ($openUrlActive): ?>
  <?=$openUrl->renderTemplate()?><br/>
<?php endif; ?>
<?php if ($doiActive): ?><?=$doi->renderTemplate()?><?php endif; ?>
